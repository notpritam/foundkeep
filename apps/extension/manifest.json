{
  "manifest_version": 3,
  "name": "Foundkeep — Save what matters",
  "version": "1.6.0",
  "description": "Save readable pages, screenshots, highlights, images and notes with their original source. Sync them to your private Foundkeep library.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Foundkeep",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*"
      ],
      "js": [
        "src/twitter.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://foundkeep.app/*",
      "https://atlas.notpritam.in/*"
    ]
  },
  "commands": {
    "region-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Screenshot a region to Foundkeep"
    },
    "full-page-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Full-page screenshot to Foundkeep"
    },
    "save-highlight": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Save the selected text to Foundkeep"
    }
  },
  "key": "",
  "update_url": "https://github.com/notpritam/foundkeep/releases/latest/download/updates.xml"
}
