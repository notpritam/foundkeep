# Foundkeep block for omni's SHARED /etc/caddy/Caddyfile.
#
# Keep API, uploads, relay, and native/extension compatibility on Bun. Next
# serves static public pages and request-scoped private React pages.
foundkeep.app {
	tls internal
	encode zstd gzip
	@backend path /api /api/* /v1 /v1/* /admin /admin/* /agent /agent/* /invite /invite/* /ext /ext/* /healthz /customer-config.json /mobile-policy.json /updates.xml /atlas-extension.zip /foundkeep-extension.zip /.well-known/* /redeem /redeem.html
	handle @backend {
		reverse_proxy 127.0.0.1:8790
	}
	handle {
		reverse_proxy 127.0.0.1:8791
	}
}

www.foundkeep.app {
	tls internal
	redir https://foundkeep.app{uri} permanent
}

# Redirect human-facing Atlas pages while version 1.5 extensions retain their
# original API, relay, health, and package endpoints during migration.
atlas.notpritam.in {
	@extension_compat path /api /api/* /v1 /v1/* /admin /admin/* /agent /agent/* /healthz /updates.xml /atlas-extension.zip /foundkeep-extension.zip /ext/*
	handle @extension_compat {
		reverse_proxy localhost:8790
	}
	handle {
		redir https://foundkeep.app{uri} permanent
	}
}
